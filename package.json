{
  "name": "meet-transcript-notes",
  "version": "0.2.0",
  "private": true,
  "description": "Chrome MV3 extension that transcribes Google Meet calls locally with Whisper large-v3-turbo.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:model-manifest": "node --experimental-strip-types scripts/gen-model-manifest.ts",
    "gen:bench-sample": "sh scripts/gen-bench-sample.sh",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "hash-wasm": "4.13.0",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/chrome": "0.3.7",
    "@types/node": "22.20.5",
    "@webgpu/types": "0.1.74",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  },
  "overrides": {
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4"
  }
}
